{
  "id": "paper-journal",
  "name": "纸页手记",
  "version": 1,
  "description": "内刊手记气质：左轨标签、纸色页边、文献式摘录。适合复盘与档案。",
  "structure_model": {
    "voice": "journal",
    "density": "balanced",
    "heading": "labeled-rail",
    "surface": "paper",
    "rhythm": "documentary"
  },
  "tokens": {
    "color": {
      "page": "#FBF7F0",
      "ink": "#3F2E22",
      "ink_muted": "#6B5748",
      "brand": "#8B5E3C",
      "brand_soft": "#F3E6D4",
      "brand_ink": "#6B4226",
      "accent": "#2F5D46",
      "rule": "#E4D5C1",
      "underline": "#D4B896"
    },
    "type": {
      "stack": "kai",
      "body_size": "16px",
      "body_line_height": "1.9",
      "max_title_size": "20px"
    },
    "shape": {
      "radius": "2px",
      "shadow": "none"
    },
    "layout": {
      "max_width": "677px",
      "gutter": "20px"
    }
  },
  "underline_css": "border-bottom:2px solid #D4B896;font-weight:600;",
  "tags": {
    "craft": [
      "左轨",
      "纸感",
      "摘录"
    ],
    "mood": [
      "沉静",
      "档案"
    ],
    "scenes": [
      "复盘",
      "内刊",
      "手记"
    ]
  },
  "slots": [
    "root",
    "hero",
    "toc",
    "h2",
    "h3",
    "h3_label",
    "paragraph",
    "divider",
    "strong",
    "mark",
    "underline",
    "strike",
    "code_inline",
    "blockquote",
    "callout_tip",
    "callout_warn",
    "quote_pull",
    "ul",
    "ol",
    "table",
    "code_dark",
    "code_light",
    "image",
    "image_gif",
    "media_ph",
    "footer"
  ],
  "signature_slots": [
    "rail-digest",
    "field-note",
    "page-folio",
    "excerpt-clip",
    "date-chip",
    "archive-head",
    "afterword",
    "source-line",
    "margin-label",
    "blot-mark"
  ],
  "files": {
    "library": "THEME.md",
    "preview": "preview.html"
  }
}
